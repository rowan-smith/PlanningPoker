{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/domain",
    "packages/contracts",
    "packages/application",
    "packages/persistence/forge",
    "packages/integrations/jira",
    "packages/ui",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "build:demo": "npm run build:demo --workspace @planning-poker/jira-forge",
    "test:e2e": "npm run build:demo && playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "glob": "^14.0.2",
    "prosemirror-view": "^1.42.3"
  }
}
